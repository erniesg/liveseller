{
  "manifest_version": 3,
  "name": "LiveSeller Shopee Copilot",
  "version": "0.1.0",
  "description": "Observes an authenticated seller tab and executes approved LiveSeller commands.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.shopee.sg/*",
    "https://*.shopee.com.my/*",
    "https://*.shopee.co.id/*",
    "https://*.shopee.ph/*",
    "https://*.shopee.co.th/*",
    "https://*.shopee.vn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LiveSeller Shopee Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.shopee.sg/*",
        "https://*.shopee.com.my/*",
        "https://*.shopee.co.id/*",
        "https://*.shopee.ph/*",
        "https://*.shopee.co.th/*",
        "https://*.shopee.vn/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
